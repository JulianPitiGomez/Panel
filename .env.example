APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 - fotos de productos de la tienda (ver ImagenProductoService)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
R2_URL=https://img.tudominio.com
IMAGENES_PRODUCTOS_DISK=r2

# Tienda web PyMEs: ids de config_clientes habilitados durante el piloto (vacio = todos)
TIENDA_CLIENTES_HABILITADOS=1
# Mostrar la tienda a los comercios que no la tienen (pantalla de contratacion). Apagado hasta terminar el modulo.
TIENDA_OFRECER_SERVICIO=false
# Dominio propio de las tiendas (F6): host de los CNAME, IPs para registros A, otros hosts nuestros
TIENDA_DOMINIO_CNAME=
TIENDA_DOMINIO_IPS=
TIENDA_DOMINIO_HOSTS_PROPIOS=
# Token que manda gestion (Fivewin) en el header X-Gestion-Token; vacio = integracion apagada
TIENDA_GESTION_TOKEN=
# Los pedidos de la tienda nacen en W (web en revision) y no aparecen en Pedidos hasta que el comercio los pasa; false = nacen en P
TIENDA_PEDIDOS_EN_REVISION=true

# Google Maps: clave de navegador (mapa y autocompletado; restringida por sitio web)
GOOGLE_MAPS_API_KEY=
# Clave para llamadas desde el servidor (geocodificacion; restringida por IP). Opcional.
GOOGLE_MAPS_SERVER_KEY=

# Claude (Anthropic): descripciones del catalogo con IA. Clave de BCN. Sin clave, la funcion queda deshabilitada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

VITE_APP_NAME="${APP_NAME}"
