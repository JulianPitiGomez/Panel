# ============================================
# CRM BCN - Variables de Entorno
# ============================================

APP_NAME="CRM BCN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ============================================
# BASE DE DATOS PRINCIPAL (CRM)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_app
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# BASE DE DATOS BCNSOFT
# ============================================
DB_BCNSOFT_HOST=127.0.0.1
DB_BCNSOFT_PORT=3306
DB_BCNSOFT_DATABASE=bcn_config
DB_BCNSOFT_USERNAME=root
DB_BCNSOFT_PASSWORD=

# ============================================
# BASE DE DATOS PEDIDOSBCN
# ============================================
DB_PEDIDOSBCN_HOST=127.0.0.1
DB_PEDIDOSBCN_PORT=3306
DB_PEDIDOSBCN_DATABASE=pedidospru
DB_PEDIDOSBCN_USERNAME=root
DB_PEDIDOSBCN_PASSWORD=

# ============================================
# LIVECONNECT
# ============================================
LIVECONNECT_API_URL=https://api.liveconnect.chat/prod
LIVECONNECT_CKEY=
LIVECONNECT_PRIVATE_KEY=

# ============================================
# AFIP (Facturación Electrónica)
# ============================================
AFIP_ENVIRONMENT=production
AFIP_CERT_PATH=storage/app/afip/certs
AFIP_KEY_PATH=storage/app/afip/keys

# ============================================
# MERCADO PAGO (opcional - para integración API)
# ============================================
MP_ACCESS_TOKEN=

# ============================================
# REDIS (para colas y caché)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

# ============================================
# MAIL
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="crm@bcnsoft.com.ar"
MAIL_FROM_NAME="${APP_NAME}"
